# 数据库连接字符串
# 如果注释掉此行，系统默认在本地根目录使用 SQLite (diaoyu.db)
# 若想使用 MySQL，请解除下方注释并填入真实的数据库账号、密码、IP、端口和数据库名
# 注意：使用 MySQL 前需要先安装驱动：pip install pymysql python-dotenv

# DATABASE_URL=mysql+pymysql://root:123456@127.0.0.1:3306/diaoyu_db?charset=utf8mb4

# 阿里云大模型 API KEY
DASHSCOPE_API_KEY=your_dashscope_key_here

# 微信小程序配置
WX_APPID=your_wx_appid_here
WX_APP_SECRET=your_wx_app_secret_here

# 和风天气 API KEY
QWEATHER_API_KEY=your_qweather_key_here
