/**
 * 全局样式
 */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  background-color: #f5f5f5;
  color: #333333;
  font-size: 28rpx;
  line-height: 1.5;
}

.container {
  padding: 20rpx 30rpx;
}

/* 卡片通用样式 */
.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

/* 状态标签 */
.status-tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.status-tag.connected {
  background: #e8f5e9;
  color: #2e7d32;
}

.status-tag.disconnected {
  background: #ffebee;
  color: #c62828;
}

.status-tag.syncing {
  background: #fff3e0;
  color: #e65100;
}

/* 数据值 */
.data-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #1a73e8;
}

.data-unit {
  font-size: 24rpx;
  color: #999999;
  margin-left: 4rpx;
}

.data-label {
  font-size: 24rpx;
  color: #999999;
  margin-top: 4rpx;
}

/* 按钮样式 */
.btn-primary {
  background: #1a73e8;
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 20rpx 0;
  text-align: center;
  border: none;
}

.btn-primary::after {
  border: none;
}

.btn-primary.disabled {
  background: #b0c4de;
  color: #e0e0e0;
}

.btn-danger {
  background: #e53935;
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 20rpx 0;
  text-align: center;
  border: none;
}

.btn-danger::after {
  border: none;
}
