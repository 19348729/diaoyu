.container { padding: 30rpx; background: #f5f5f5; min-height: 100vh; }
.header { font-size: 40rpx; font-weight: bold; margin-bottom: 40rpx; color: #333; }
.section { background: #fff; border-radius: 16rpx; padding: 30rpx; margin-bottom: 40rpx; }
.title { font-size: 32rpx; font-weight: bold; margin-bottom: 30rpx; text-align: center; }
.grid { display: grid; grid-template-columns: 1fr 1fr; gap: 30rpx; }
.level-card { background: #f8f9fa; border: 4rpx solid transparent; border-radius: 16rpx; padding: 40rpx 0; display: flex; flex-direction: column; align-items: center; transition: all 0.3s; }
.level-card.active { border-color: #1a73e8; background: #e8f0fe; }
.emoji { font-size: 60rpx; margin-bottom: 10rpx; }
.text { font-size: 28rpx; color: #333; font-weight: bold; }
.btn-primary { background: #1a73e8; color: #fff; border-radius: 40rpx; font-size: 34rpx; width: 100%; box-sizing: border-box; }
.btn-outline { background: #fff; color: #1a73e8; border: 2rpx solid #1a73e8; border-radius: 40rpx; font-size: 34rpx; }
.mt { margin-top: 30rpx; }

.poster-container { margin-top: 50rpx; }
.poster { padding: 60rpx 40rpx; border-radius: 20rpx; text-align: center; box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.1); margin-bottom: 30rpx; }
.p-title { font-size: 44rpx; font-weight: bold; color: #333; margin-bottom: 40rpx; }
.p-line { font-size: 32rpx; color: #555; margin-bottom: 20rpx; font-weight: 500; }
