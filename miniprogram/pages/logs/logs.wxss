/* 作钓日志页面样式 */

/* 加载和空状态 */
.loading-state,
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
  color: #999;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}
.empty-text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 12rpx;
}
.empty-subtext {
  font-size: 24rpx;
  color: #aaa;
  text-align: center;
}

/* 滚动容器 */
.logs-scroll {
  height: 100vh;
  padding-bottom: 40rpx;
}

/* 会话卡片 */
.session-card {
  background: #ffffff;
  border-radius: 16rpx;
  margin: 20rpx 0;
  padding: 0;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
}

/* 卡片头部 */
.session-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 24rpx 28rpx 16rpx;
  background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
  border-bottom: 1rpx solid #f0f0f0;
}
.header-left {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.session-date {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}
.session-location {
  font-size: 24rpx;
  color: #1a73e8;
}

/* 开口指数徽章 */
.bite-badge {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
  min-width: 80rpx;
}
.bite-badge.high {
  background: linear-gradient(135deg, #ffebee 0%, #ffcdd2 100%);
}
.bite-badge.mid {
  background: linear-gradient(135deg, #fff3e0 0%, #ffe0b2 100%);
}
.bite-badge.low {
  background: linear-gradient(135deg, #f5f5f5 0%, #eeeeee 100%);
}
.bite-label {
  font-size: 20rpx;
  color: #999;
}
.bite-value {
  font-size: 36rpx;
  font-weight: 700;
}
.bite-badge.high .bite-value {
  color: #e53935;
}
.bite-badge.mid .bite-value {
  color: #fb8c00;
}
.bite-badge.low .bite-value {
  color: #757575;
}

/* 时间信息栏 */
.time-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 28rpx;
  background: #fafafa;
}
.time-range {
  font-size: 24rpx;
  color: #666;
}
.duration-tag {
  font-size: 22rpx;
  color: #1a73e8;
  background: #e3f2fd;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

/* 传感器变化区 */
.sensor-section {
  padding: 20rpx 28rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.sensor-row {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
}
.sensor-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
  width: 36rpx;
}
.sensor-name {
  font-size: 24rpx;
  color: #999;
  width: 60rpx;
  flex-shrink: 0;
}
.sensor-change {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #333;
  margin-left: 12rpx;
  gap: 2rpx;
}
.arrow {
  font-weight: 500;
  margin: 0 4rpx;
}
.change-diff {
  font-size: 22rpx;
  font-weight: 600;
  margin-left: 12rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background: #f5f5f5;
}
.press-trend {
  font-size: 22rpx;
  color: #757575;
  margin-top: 4rpx;
  padding-left: 104rpx;
}

/* 底部信息 */
.session-footer {
  display: flex;
  justify-content: space-around;
  padding: 20rpx 28rpx;
}
.footer-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}
.footer-label {
  font-size: 22rpx;
  color: #999;
}
.footer-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}
.footer-sub {
  font-size: 20rpx;
  color: #aaa;
}
.fish-name {
  color: #1a73e8;
  font-weight: 600;
}

/* 底部提示 */
.bottom-tip {
  text-align: center;
  padding: 30rpx 0 60rpx;
  font-size: 22rpx;
  color: #ccc;
}
