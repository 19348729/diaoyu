<!--
  作钓日志页面
  展示钓鱼会话摘要卡片（一次出钓 = 一张卡片）
-->
<view class="container">

  <!-- 加载中 -->
  <view class="loading-state" wx:if="{{loading}}">
    <text>加载日志中...</text>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:elif="{{sessions.length === 0}}">
    <text class="empty-icon">🎣</text>
    <text class="empty-text">暂无作钓日志</text>
    <text class="empty-subtext">连接 FishProbe 作钓 30 分钟以上，断开时可保存日志。</text>
  </view>

  <!-- 日志列表 -->
  <scroll-view wx:else scroll-y class="logs-scroll">
    <view class="session-card" wx:for="{{sessions}}" wx:key="id">

      <!-- 头部：日期 + 开口指数 -->
      <view class="session-header">
        <view class="header-left">
          <text class="session-date">📅 {{item.dateStr}}</text>
          <text class="session-location">📍 {{item.locationName}}</text>
        </view>
        <view class="bite-badge {{item.biteLevel}}">
          <text class="bite-label">开口</text>
          <text class="bite-value">{{item.biteIndexMax}}</text>
        </view>
      </view>

      <!-- 时间信息栏 -->
      <view class="time-bar">
        <text class="time-range">🕐 {{item.timeRange}}</text>
        <text class="duration-tag">{{item.durationStr}}</text>
      </view>

      <!-- 传感器变化区 -->
      <view class="sensor-section">
        <!-- 水温 -->
        <view class="sensor-row" wx:if="{{item.waterChange}}">
          <text class="sensor-icon">🌡️</text>
          <text class="sensor-name">水温</text>
          <view class="sensor-change">
            <text>{{item.waterChange.start}}℃</text>
            <text class="arrow" style="color: {{item.waterChange.color}}"> → </text>
            <text>{{item.waterChange.end}}℃</text>
            <text class="change-diff" style="color: {{item.waterChange.color}}">{{item.waterChange.arrow}} {{item.waterChange.diff}}℃</text>
          </view>
        </view>

        <!-- 气温 -->
        <view class="sensor-row" wx:if="{{item.airChange}}">
          <text class="sensor-icon">🌡️</text>
          <text class="sensor-name">气温</text>
          <view class="sensor-change">
            <text>{{item.airChange.start}}℃</text>
            <text class="arrow" style="color: {{item.airChange.color}}"> → </text>
            <text>{{item.airChange.end}}℃</text>
            <text class="change-diff" style="color: {{item.airChange.color}}">{{item.airChange.arrow}} {{item.airChange.diff}}℃</text>
          </view>
        </view>

        <!-- 气压 -->
        <view class="sensor-row" wx:if="{{item.pressChange}}">
          <text class="sensor-icon">📊</text>
          <text class="sensor-name">气压</text>
          <view class="sensor-change">
            <text>{{item.pressChange.start}}</text>
            <text class="arrow" style="color: {{item.pressChange.color}}"> → </text>
            <text>{{item.pressChange.end}} hPa</text>
            <text class="change-diff" style="color: {{item.pressChange.color}}">{{item.pressChange.arrow}} {{item.pressChange.diff}}</text>
          </view>
        </view>
        <view class="press-trend" wx:if="{{item.pressChange.trend}}">
          <text>趋势: {{item.pressChange.trend}}</text>
        </view>
      </view>

      <!-- 底部：天气 + 推荐鱼种 -->
      <view class="session-footer">
        <view class="footer-item">
          <text class="footer-label">⛅ 天气</text>
          <text class="footer-value">{{item.weatherText}}</text>
          <text class="footer-sub" wx:if="{{item.windDesc}}">{{item.windDesc}}</text>
        </view>
        <view class="footer-item">
          <text class="footer-label">🐟 推荐鱼种</text>
          <text class="footer-value fish-name">{{item.recommendedFish}}</text>
        </view>
      </view>

    </view>

    <view class="bottom-tip">
      <text>- 最近 20 次作钓记录 -</text>
    </view>
  </scroll-view>

</view>
