.container { padding: 30rpx; background: #f5f5f5; min-height: 100vh; box-sizing: border-box; }

.card { background: #fff; border-radius: 16rpx; padding: 30rpx; margin-bottom: 30rpx; box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04); }
.card-title { font-size: 34rpx; font-weight: bold; color: #1a73e8; margin-bottom: 12rpx; }
.hint-line { font-size: 22rpx; color: #90a4ae; margin-bottom: 24rpx; line-height: 1.5; }

.field-label { font-size: 28rpx; font-weight: 600; color: #3c4257; margin: 24rpx 0 14rpx; }
.opt { font-size: 22rpx; font-weight: 400; color: #aaa; margin-left: 10rpx; }

.chip-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.chip { padding: 12rpx 30rpx; border-radius: 30rpx; background: #f1f3f5; color: #5469d4; font-size: 28rpx; }
.chip.active { background: #1a73e8; color: #fff; font-weight: bold; }

.count-row { display: flex; align-items: center; gap: 16rpx; }
.count-btn { width: 72rpx; height: 72rpx; line-height: 64rpx; text-align: center; font-size: 44rpx; color: #1a73e8; background: #eef4ff; border-radius: 12rpx; }
.count-input { width: 120rpx; height: 72rpx; text-align: center; font-size: 34rpx; background: #f7f8fa; border-radius: 12rpx; }
.count-unit { font-size: 24rpx; color: #90a4ae; }

.weight-row { display: flex; align-items: center; gap: 14rpx; }
.weight-input { width: 200rpx; height: 72rpx; padding: 0 20rpx; font-size: 30rpx; background: #f7f8fa; border-radius: 12rpx; }
.note-input { width: 100%; box-sizing: border-box; height: 80rpx; padding: 0 20rpx; font-size: 28rpx; background: #f7f8fa; border-radius: 12rpx; }

.btn-primary { background: #1a73e8; color: #fff; border-radius: 40rpx; font-size: 32rpx; font-weight: 600; }
.mt { margin-top: 36rpx; }

.list-header { font-size: 28rpx; font-weight: bold; color: #3c4257; margin: 10rpx 0 20rpx; }
.empty { text-align: center; color: #b0bec5; font-size: 26rpx; padding: 40rpx 0; }

.log-card { background: #fff; border-radius: 14rpx; padding: 24rpx; margin-bottom: 20rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.03); }
.log-top { display: flex; justify-content: space-between; align-items: center; }
.log-title { font-size: 30rpx; font-weight: bold; color: #1a1f36; }
.log-title.skunked { color: #90a4ae; }
.log-date { font-size: 24rpx; color: #b0bec5; }
.log-meta { font-size: 24rpx; color: #5a6473; margin-top: 10rpx; }
.bi { color: #e53935; font-weight: bold; }
.log-note { font-size: 24rpx; color: #8a94a6; margin-top: 10rpx; background: #f7f8fa; border-radius: 8rpx; padding: 12rpx 16rpx; }
