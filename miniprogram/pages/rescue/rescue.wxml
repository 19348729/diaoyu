<view class="container">
  <view class="header">🏥 智能诊断</view>

  <view class="section" wx:if="{{!prescription}}">
    <view class="title">当前水面症状 (可多选)</view>
    <view class="list">
      <view class="check-item" wx:for="{{symptoms}}" wx:key="val" bindtap="toggleSymptom" data-idx="{{index}}">
        <icon type="{{item.checked ? 'success' : 'circle'}}" size="20" color="{{item.checked ? '#1a73e8' : '#ccc'}}"/>
        <text class="check-text">{{item.label}}</text>
      </view>
    </view>

    <!-- 当前用的钓法 / 饵料（选填，帮助 AI 更对症开方） -->
    <view class="title mt">现在用的钓法 <text class="sub-hint">选填</text></view>
    <view class="chip-grid">
      <view class="chip {{curMethod === item ? 'active' : ''}}" wx:for="{{methodOptions}}" wx:key="*this" bindtap="selectMethod" data-val="{{item}}">{{item}}</view>
    </view>

    <view class="title mt">现在用的饵料 <text class="sub-hint">选填</text></view>
    <view class="chip-grid">
      <view class="chip {{curBait === item ? 'active' : ''}}" wx:for="{{baitOptions}}" wx:key="*this" bindtap="selectBait" data-val="{{item}}">{{item}}</view>
    </view>

    <button class="btn-primary mt" bindtap="requestRescue" loading="{{isRescuing}}">请求 AI 开方</button>
  </view>

  <view class="card" wx:if="{{prescription}}">
    <view class="card-title">🏥 AI 战术处方</view>
    <view class="diag-section">
      <view class="diag-label">诊断分析：</view>
      <view class="diag-text">{{prescription.diagnosis}}</view>
    </view>
    <view class="presc-list">
      <view class="presc-item" wx:for="{{prescription.prescriptions}}" wx:key="action">
        <view class="presc-action">🎯 {{item.action}}</view>
        <view class="presc-reason">原理：{{item.reason}}</view>
      </view>
    </view>

    <!-- 装备上下文提示（AI 已将钓箱作为处方上下文） -->
    <view wx:if="{{prescription.diagnosis}}" style="font-size: 22rpx; color: #1565c0; background: #e3f2fd; border-radius: 6rpx; padding: 8rpx 16rpx; margin-top: 16rpx; display: inline-block;">🎒 已结合你的数字钓箱生成处方</view>
    <view class="note" wx:if="{{prescription.confidence_note}}">💡 {{prescription.confidence_note}}</view>
    
    <button class="btn-outline mt" bindtap="resetRescue">重新问诊</button>
  </view>
</view>
