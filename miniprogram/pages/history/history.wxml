<!--
  趋势分析页面
  展示历史传感器数据统计和详细记录
-->
<view class="container">

  <!-- 统计摘要卡片 -->
  <view class="card">
    <text class="card-title">数据概览 (共 {{recordCount}} 条，持续 {{summary.duration}})</text>

    <view class="summary-grid">
      <view class="summary-item">
        <text class="summary-label">水温范围</text>
        <text class="summary-value">{{summary.tWaterMin}} ~ {{summary.tWaterMax}} ℃</text>
      </view>
      <view class="summary-item">
        <text class="summary-label">气温范围</text>
        <text class="summary-value">{{summary.tAirMin}} ~ {{summary.tAirMax}} ℃</text>
      </view>
      <view class="summary-item">
        <text class="summary-label">气压范围</text>
        <text class="summary-value">{{summary.pLocalMin}} ~ {{summary.pLocalMax}} hPa</text>
      </view>
    </view>
  </view>

  <!-- 图表展示 -->
  <view class="card chart-card">
    <view class="chart-header">
      <text class="card-title">数据趋势图</text>
      <view class="time-filters">
        <text class="filter-item {{timeRange === 30 ? 'active' : ''}}" data-range="30" bindtap="onTimeRangeChange">30分</text>
        <text class="filter-item {{timeRange === 60 ? 'active' : ''}}" data-range="60" bindtap="onTimeRangeChange">1小时</text>
        <text class="filter-item {{timeRange === 180 ? 'active' : ''}}" data-range="180" bindtap="onTimeRangeChange">3小时</text>
        <text class="filter-item {{timeRange === 360 ? 'active' : ''}}" data-range="360" bindtap="onTimeRangeChange">6小时</text>
        <text class="filter-item {{timeRange === 0 ? 'active' : ''}}" data-range="0" bindtap="onTimeRangeChange">全部</text>
      </view>
    </view>
    <view class="chart-container temp-chart-box">
      <ec-canvas id="temp-chart-dom" canvas-id="temp-chart" ec="{{ ec }}"></ec-canvas>
    </view>
    <view class="chart-container press-chart-box">
      <ec-canvas id="press-chart-dom" canvas-id="press-chart" ec="{{ ec }}"></ec-canvas>
    </view>
  </view>

</view>
