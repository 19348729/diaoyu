/* 趋势分析页面样式 */

/* 统计摘要 */
.summary-grid {
  display: flex;
  flex-wrap: wrap;
}

.summary-item {
  width: 50%;
  padding: 12rpx 0;
  box-sizing: border-box;
}

.summary-label {
  display: block;
  font-size: 22rpx;
  color: #999999;
  margin-bottom: 4rpx;
}

.summary-value {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.summary-value.warn {
  color: #e53935;
}

/* 数据列表 */
.list-card {
  padding-bottom: 10rpx;
}

.list-header {
  display: flex;
  padding: 12rpx 0;
  border-bottom: 2rpx solid #e0e0e0;
  font-size: 22rpx;
  color: #999999;
  font-weight: 600;
}

.list-row {
  display: flex;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  font-size: 24rpx;
  color: #333333;
}

.list-row:last-child {
  border-bottom: none;
}

.col-time {
  width: 25%;
  text-align: center;
}

.col-data {
  width: 18.75%;
  text-align: center;
}

.list-scroll {
  max-height: 800rpx;
}

.list-empty {
  padding: 60rpx 0;
  text-align: center;
  color: #cccccc;
  font-size: 26rpx;
}
