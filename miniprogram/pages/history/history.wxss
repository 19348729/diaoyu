/* 趋势分析页面样式 */

/* 统计摘要 */
.summary-grid {
  display: flex;
  flex-wrap: wrap;
}

.summary-item {
  width: 50%;
  padding: 12rpx 0;
  box-sizing: border-box;
}

.summary-label {
  display: block;
  font-size: 22rpx;
  color: #999999;
  margin-bottom: 4rpx;
}

.summary-value {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.summary-value.warn {
  color: #e53935;
}

/* 图表样式 */
.chart-card {
  padding-bottom: 20rpx;
}

.chart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.chart-header .card-title {
  margin-bottom: 0;
}

.time-filters {
  display: flex;
  background: #f5f5f5;
  border-radius: 8rpx;
  padding: 4rpx;
}

.filter-item {
  font-size: 20rpx;
  color: #666;
  padding: 8rpx 16rpx;
  border-radius: 6rpx;
  transition: all 0.2s;
}

.filter-item.active {
  background: #ffffff;
  color: #1890FF;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
  font-weight: 500;
}

.chart-container {
  width: 100%;
  height: 600rpx;
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
}

ec-canvas {
  width: 100%;
  height: 100%;
}
