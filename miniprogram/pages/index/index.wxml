<!--
  实时监测页面
  展示 BLE 连接状态和传感器实时数据
-->
<view class="container">

  <!-- 顶部的精美设备状态条 (替换原有的厚重连接卡片) -->
  <view class="connection-status-bar {{bleConnected ? 'connected-bar' : (connecting ? 'connecting-bar' : 'disconnected-bar')}} card-shadow">
    <view class="bar-left">
      <view class="pulse-dot" wx:if="{{bleConnected}}"></view>
      <view class="syncing-dot" wx:elif="{{connecting}}"></view>
      <view class="offline-dot" wx:else></view>
      <text class="bar-status-text">{{connecting ? '正在配对 FishProbe 设备...' : (bleConnected ? 'FishProbe 已连接 ⚡' : '未连接 FishProbe 设备')}}</text>
    </view>
    <view class="bar-right">
      <text class="action-link" bindtap="onTapConnect">{{bleConnected ? '断开连接' : '去连接设备'}}</text>
    </view>
  </view>

  <!-- 未连接设备：实时监测需连接设备；纯气象预测请走「出钓决策」 -->
  <view class="no-device-guide card-shadow" wx:if="{{!bleConnected}}" style="background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%); border-radius: 12rpx; padding: 24rpx; margin-bottom: 20rpx;">
    <text style="font-size: 26rpx; color: #1565c0; display: block; margin-bottom: 16rpx;">📡 实时监测需连接 FishProbe 设备。没有设备？看「出钓决策」即可获取基于气象+定位的开口指数与建议。</text>
    <view style="display: flex; gap: 20rpx;">
      <text style="flex: 1; text-align: center; font-size: 26rpx; color: #fff; background: #1a73e8; border-radius: 30rpx; padding: 14rpx 0;" bindtap="onTapConnect">🔗 去连接设备</text>
      <text style="flex: 1; text-align: center; font-size: 26rpx; color: #1a73e8; background: #fff; border: 1px solid #1a73e8; border-radius: 30rpx; padding: 14rpx 0;" bindtap="goToDecision">🌤️ 看出钓决策</text>
    </view>
  </view>

  <!-- 仅在连接时，展示细致的设备缓存与数据同步微面板 -->
  <view class="sync-mini-panel card-shadow" wx:if="{{bleConnected}}">
    <view class="sync-row">
      <text class="sync-label">实时传输</text>
      <text class="sync-value">实时 {{realtimeCount}} 条 / 历史补传 {{historyCount}} 条</text>
    </view>
    <view class="sync-row">
      <text class="sync-label">缓存同步</text>
      <view class="sync-value">
        <text>{{bufferUnsent}}/{{bufferCount}} 条待同步</text>
        <text class="mini-btn" catchtap="onTapQueryStatus">🔄 刷新</text>
        <text class="mini-btn-sep">|</text>
        <text class="mini-btn {{bufferUnsent > 0 ? '' : 'mini-btn-disabled'}}" catchtap="onTapPullHistory">📥 补传历史</text>
      </view>
    </view>
  </view>

  <!-- 传感器数据卡片（仅连接设备时展示） -->
  <view class="card" wx:if="{{bleConnected}}">
    <view class="sensor-header">
      <text class="card-title" style="margin-bottom: 0; padding-bottom: 0; border-bottom: none;">传感器数据</text>
      <view class="sensor-trend-btn" catchtap="goToHistory">📊 历史趋势</view>
    </view>
    
    <view class="temp-grid" bindtap="goToHistory" hover-class="grid-hover" hover-stay-time="100">
      <view class="temp-item">
        <text class="data-value">{{tWater}}</text>
        <text class="data-unit">℃</text>
        <text class="data-label">水温</text>
      </view>
      <view class="temp-item">
        <text class="data-value">{{tAir}}</text>
        <text class="data-unit">℃</text>
        <text class="data-label">气温</text>
      </view>
      <view class="temp-item">
        <text class="data-value large">{{pLocal}}</text>
        <text class="data-unit">hPa</text>
        <text class="data-label">本地气压</text>
      </view>
    </view>
  </view>

  <!-- 天气情况展示 -->
  <view class="card" wx:if="{{weatherInfo}}" style="background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);">
    <text class="card-title" style="color: #1565c0;">⛅ 实时天气 (基于GPS)</text>
    <view style="display: flex; justify-content: space-between; margin-top: 15rpx; margin-bottom: 15rpx;">
      <text style="font-size: 32rpx; color: #0d47a1; font-weight: bold;">{{weatherInfo.text}}</text>
      <text style="font-size: 28rpx; color: #1565c0;">{{weatherInfo.wind_dir}}</text>
    </view>
    <view style="display: flex; justify-content: space-between; border-top: 1px solid rgba(255,255,255,0.5); padding-top: 15rpx;">
      <text style="font-size: 26rpx; color: #1565c0;">风速: {{weatherInfo.wind_speed}} m/s</text>
      <text style="font-size: 26rpx; color: #1565c0;">相对湿度: {{weatherInfo.humidity}}%</text>
    </view>
  </view>

  <!-- 预测结果展示 -->
  <view class="card" wx:if="{{biteIndex !== '--'}}">
    <!-- 预测新鲜度状态栏 -->
    <view class="predict-freshness-bar {{predictFreshness}}">
      <view class="freshness-left">
        <view class="freshness-dot {{predictFreshness}}"></view>
        <text class="freshness-status">{{predictStatusText}}</text>
        <text class="freshness-time" wx:if="{{predictTimeText}}">· {{predictTimeText}}</text>
      </view>
      <view class="freshness-right">
        <view class="refresh-btn {{predicting ? 'loading' : ''}}" catchtap="onTapRefreshPredict">
          <text wx:if="{{!predicting}}">🔄 刷新</text>
          <text wx:else>⏳</text>
        </view>
      </view>
    </view>

    <!-- 渐进式分析阶段（随本次连接时长推进） -->
    <view class="stage-card" wx:if="{{predictStage}}">
      <view class="stage-top">
        <text class="stage-top-label">📊 分析阶段 · {{predictStageText}}</text>
        <view class="stage-conf">
          <text class="stage-conf-num">{{predictConfidence}}%</text>
          <text class="stage-conf-label">置信度</text>
        </view>
      </view>
      <view class="stage-steps">
        <view class="stage-step {{predictStageIndex >= 0 ? 'done' : ''}}">
          <view class="stage-dot"></view>
          <text class="stage-name">即时</text>
        </view>
        <view class="stage-line {{predictStageIndex >= 1 ? 'done' : ''}}"></view>
        <view class="stage-step {{predictStageIndex >= 1 ? 'done' : ''}}">
          <view class="stage-dot"></view>
          <text class="stage-name">初步·5min</text>
        </view>
        <view class="stage-line {{predictStageIndex >= 2 ? 'done' : ''}}"></view>
        <view class="stage-step {{predictStageIndex >= 2 ? 'done' : ''}}">
          <view class="stage-dot"></view>
          <text class="stage-name">标准·10min</text>
        </view>
        <view class="stage-line {{predictStageIndex >= 3 ? 'done' : ''}}"></view>
        <view class="stage-step {{predictStageIndex >= 3 ? 'done' : ''}}">
          <view class="stage-dot"></view>
          <text class="stage-name">深度·30min</text>
        </view>
      </view>
      <text class="stage-next">⏳ {{predictNextHint}}</text>
    </view>

    <view class="card-title" style="display: flex; justify-content: space-between; align-items: center; width: 100%; border-top: none; margin-top: 0; padding-top: 0;">
      <text wx:if="{{targetFish}}">🎯 目标鱼种: {{targetFish}}</text>
      <text wx:else>🎯 最适宜作钓: {{recommendedFish}}</text>
      <text style="font-size: 24rpx; color: #666; font-weight: normal;">{{targetFish ? '(当前选择)' : '(系统智能推荐)'}}</text>
    </view>
    
    <view style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; margin-top: 10rpx; padding: 20rpx; border-radius: 12rpx; background: {{biteRatingBg || '#f5f5f5'}};">
      <view style="display: flex; flex-direction: column;">
        <text style="font-size: 28rpx; color: #666;">开口指数</text>
        <text style="font-size: 24rpx; color: {{biteRatingColor || '#999'}}; margin-top: 6rpx; font-weight: 600;">{{biteRatingText}}</text>
      </view>
      <text style="font-size: 56rpx; font-weight: bold; color: {{biteRatingColor || '#e53935'}};">{{biteIndex}}</text>
    </view>
    
    <view style="display: flex; flex-wrap: wrap; gap: 10rpx; margin-bottom: 30rpx;">
      <text wx:for="{{tacticalTags}}" wx:key="*this" style="background: #e3f2fd; color: #1565c0; padding: 6rpx 16rpx; border-radius: 8rpx; font-size: 24rpx;">{{item}}</text>
    </view>

    <!-- 智能作钓策略展示 -->
    <view wx:if="{{tacticalAdvice}}" style="background: #fff8e1; border: 1px solid #ffecb3; border-radius: 8rpx; padding: 20rpx; margin-bottom: 30rpx;">
      <text style="font-size: 28rpx; color: #f57f17; font-weight: bold; display: block; margin-bottom: 15rpx;">💡 智能作钓策略</text>
      
      <!-- 利好信号（高亮展示） -->
      <view wx:if="{{tacticalAdvice.highlight}}" style="background: linear-gradient(135deg, #e8f5e9 0%, #c8e6c9 100%); border: 1px solid #a5d6a7; border-radius: 8rpx; padding: 16rpx; margin-bottom: 16rpx;">
        <text style="font-size: 26rpx; color: #2e7d32; font-weight: bold;">{{tacticalAdvice.highlight}}</text>
      </view>

      <!-- 鱼种活性描述 -->
      <view wx:if="{{tacticalAdvice.fish_activity}}" style="background: #e3f2fd; border-radius: 6rpx; padding: 12rpx 16rpx; margin-bottom: 16rpx;">
        <text style="font-size: 24rpx; color: #1565c0;">🐟 {{tacticalAdvice.fish_activity}}</text>
      </view>

      <!-- 钓点策略（按钓点类型/鱼密度/水色） -->
      <view wx:if="{{tacticalAdvice.spot_strategy}}" style="background: #f1f8e9; border: 1px solid #c5e1a5; border-radius: 6rpx; padding: 12rpx 16rpx; margin-bottom: 16rpx;">
        <text style="font-size: 24rpx; color: #558b2f;">📍 钓点策略：{{tacticalAdvice.spot_strategy}}</text>
      </view>

      <view style="display: flex; flex-direction: column; gap: 12rpx;">
        <view style="display: flex; align-items: flex-start;">
          <text style="font-size: 26rpx; color: #f57f17; min-width: 120rpx; font-weight: bold;">🌊 建议水层:</text>
          <text style="font-size: 26rpx; color: #424242; flex: 1;">{{tacticalAdvice.layer}}</text>
        </view>
        <view style="display: flex; align-items: flex-start;">
          <text style="font-size: 26rpx; color: #f57f17; min-width: 120rpx; font-weight: bold;">🍤 用饵建议:</text>
          <text style="font-size: 26rpx; color: #424242; flex: 1;">{{tacticalAdvice.bait}}</text>
        </view>
        <view style="display: flex; align-items: flex-start;">
          <text style="font-size: 26rpx; color: #f57f17; min-width: 120rpx; font-weight: bold;">🎣 作钓方式:</text>
          <text style="font-size: 26rpx; color: #424242; flex: 1;">{{tacticalAdvice.method || selectedMethod || '台钓'}}</text>
        </view>
        <view style="display: flex; align-items: flex-start;">
          <text style="font-size: 26rpx; color: #f57f17; min-width: 120rpx; font-weight: bold;">📏 建议钓深:</text>
          <text style="font-size: 26rpx; color: #424242; flex: 1;">{{tacticalAdvice.depth || '--'}}</text>
        </view>
        <view style="display: flex; align-items: flex-start;">
          <text style="font-size: 26rpx; color: #f57f17; min-width: 120rpx; font-weight: bold;">🎯 抛竿节奏:</text>
          <text style="font-size: 26rpx; color: #424242; flex: 1;">{{tacticalAdvice.rhythm}}</text>
        </view>
        <view style="display: flex; align-items: flex-start;">
          <text style="font-size: 26rpx; color: #f57f17; min-width: 120rpx; font-weight: bold;">📍 钓位选择:</text>
          <text style="font-size: 26rpx; color: #424242; flex: 1;">{{tacticalAdvice.spot || '选深浅交界处'}}</text>
        </view>
        <view wx:if="{{tacticalAdvice.estimated_water_temp}}" style="display: flex; align-items: flex-start;">
          <text style="font-size: 26rpx; color: #f57f17; min-width: 120rpx; font-weight: bold;">🌡️ 推算水温:</text>
          <text style="font-size: 26rpx; color: #424242; flex: 1;">{{tacticalAdvice.estimated_water_temp}}</text>
        </view>
        <view style="display: flex; align-items: flex-start; margin-top: 5rpx; padding-top: 10rpx; border-top: 1px dashed #ffecb3;" wx:if="{{tacticalAdvice.risk && tacticalAdvice.risk !== '当前无明显风险'}}">
          <text style="font-size: 24rpx; color: #d32f2f; min-width: 120rpx; font-weight: bold;">⚠️ 风险提示:</text>
          <text style="font-size: 24rpx; color: #d32f2f; flex: 1;">{{tacticalAdvice.risk}}</text>
        </view>
      </view>
    </view>

    <!-- 鱼种开口排行榜 -->
    <view style="border-top: 1px dashed #eee; padding-top: 20rpx;">
      <text style="font-size: 26rpx; color: #999; display: block; margin-bottom: 15rpx;">🏆 全鱼种适宜度排行榜</text>
      <view style="display: flex; flex-direction: column; gap: 10rpx;">
        <view wx:for="{{fishRanking}}" wx:key="name" style="display: flex; justify-content: space-between; align-items: center; background: #f9f9f9; padding: 10rpx 20rpx; border-radius: 8rpx;">
          <view style="display: flex; align-items: center; gap: 10rpx;">
            <text style="font-size: 28rpx; color: {{index === 0 ? '#e53935' : '#333'}}; font-weight: {{index === 0 ? 'bold' : 'normal'}};">{{index + 1}}. {{item.name}}</text>
          </view>
          <text style="font-size: 28rpx; font-weight: bold; color: {{item.score >= 60 ? (item.score >= 80 ? '#e53935' : '#fb8c00') : '#757575'}};">{{item.score}} 分</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 更新时间 -->
  <view class="update-time">
    <text>最后更新: {{updateTime}}</text>
  </view>

  <!-- 查看趋势图按钮 -->
  <view style="margin: 30rpx; padding-bottom: 50rpx;">
    <button class="btn-primary" bindtap="goToHistory" style="background: #1976d2; color: #fff; width: 100%; border-radius: 8rpx;">📊 查看实时趋势图 (折线图)</button>
  </view>

</view>
