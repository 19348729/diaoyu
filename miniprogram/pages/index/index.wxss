/* 实时监测页面样式 */

.status-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.status-header .card-title {
  margin-bottom: 0;
  padding-bottom: 0;
  border-bottom: none;
}

/* 设备信息 */
.device-info {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
}

.info-label {
  font-size: 24rpx;
  color: #999999;
}

.info-value {
  font-size: 24rpx;
  color: #666666;
}

.info-value.link {
  color: #1a73e8;
}

.info-value .link {
  color: #1a73e8;
  padding: 0 4rpx;
}

.info-value .link-disabled {
  color: #bbbbbb;
}

/* 三层水温网格 */
.temp-grid {
  display: flex;
  justify-content: space-around;
  text-align: center;
}

.temp-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
}

/* 温差显示 */
.temp-diff {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.diff-label {
  font-size: 24rpx;
  color: #999999;
  margin-right: 16rpx;
}

.diff-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.diff-value.warn {
  color: #e53935;
}

/* 气压显示 */
.pressure-display {
  display: flex;
  align-items: baseline;
  justify-content: center;
  padding: 20rpx 0;
}

.data-value.large {
  font-size: 64rpx;
}

/* 更新时间 */
.update-time {
  text-align: center;
  padding: 20rpx 0;
  font-size: 22rpx;
  color: #bbbbbb;
}

/* ============================================
   预测新鲜度状态栏
   ============================================ */
.predict-freshness-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 16rpx;
  border-radius: 10rpx;
  margin-bottom: 16rpx;
  transition: background-color 0.3s ease;
}

/* 新鲜度背景色 */
.predict-freshness-bar.fresh {
  background: linear-gradient(135deg, #e8f5e9 0%, #c8e6c9 100%);
}
.predict-freshness-bar.normal {
  background: linear-gradient(135deg, #fff8e1 0%, #ffecb3 100%);
}
.predict-freshness-bar.stale {
  background: linear-gradient(135deg, #fff3e0 0%, #ffe0b2 100%);
}
.predict-freshness-bar.expired {
  background: linear-gradient(135deg, #ffebee 0%, #ffcdd2 100%);
}
.predict-freshness-bar.none {
  background: #f5f5f5;
}

.freshness-left {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

/* 新鲜度指示圆点 */
.freshness-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.freshness-dot.fresh {
  background: #4caf50;
  box-shadow: 0 0 6rpx rgba(76, 175, 80, 0.6);
  animation: pulse-green 2s infinite;
}
.freshness-dot.normal {
  background: #ffc107;
  box-shadow: 0 0 6rpx rgba(255, 193, 7, 0.6);
}
.freshness-dot.stale {
  background: #ff9800;
  box-shadow: 0 0 6rpx rgba(255, 152, 0, 0.6);
  animation: pulse-orange 1.5s infinite;
}
.freshness-dot.expired {
  background: #f44336;
  box-shadow: 0 0 6rpx rgba(244, 67, 54, 0.6);
  animation: pulse-red 1s infinite;
}
.freshness-dot.none {
  background: #bdbdbd;
}

@keyframes pulse-green {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}
@keyframes pulse-orange {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.6; transform: scale(1.15); }
}
@keyframes pulse-red {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.5; transform: scale(1.3); }
}

.freshness-status {
  font-size: 22rpx;
  font-weight: 600;
  color: #424242;
}
.freshness-time {
  font-size: 22rpx;
  color: #757575;
}

/* 刷新按钮 */
.refresh-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.7);
  font-size: 22rpx;
  font-weight: 500;
  color: #1a73e8;
  border: 1rpx solid rgba(26, 115, 232, 0.3);
}
.refresh-btn:active {
  background: rgba(26, 115, 232, 0.1);
}
.refresh-btn.loading {
  color: #999;
  border-color: #ddd;
  animation: spin-slow 1.5s linear infinite;
}

@keyframes spin-slow {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}
