<view class="container">
  <view class="header">
    <text class="header-title">作钓准备：配置您的专属策略</text>
  </view>

  <!-- 1. 网格配置区（未连接 或 修改状态下 显示） -->
  <block wx:if="{{!isConnected || isModifying}}">
    <view class="section card-shadow">
      <view class="title">目标鱼种 <text class="title-hint">选「智能推荐」由系统判断</text></view>
      <view class="grid">
        <view class="tag {{targetFish === item ? 'active' : ''}}" wx:for="{{fishOptions}}" wx:key="*this" bindtap="selectFish" data-val="{{item}}">{{item}}</view>
      </view>
      <!-- 智能推荐气泡提示 -->
      <view class="recommendation-tip" wx:if="{{recommendationTip}}">
        <text class="tip-text">{{recommendationTip}}</text>
      </view>
      <view class="recommendation-tip" style="background: rgba(245,127,23,0.06); border-left-color: #f57f17;">
        <text class="tip-text" style="color: #b26a00;">🎣 钓法与用饵无需在此预选——进入大屏后系统会按实时水情给出建议；作钓不顺时再去「AI救场」填写当前用的钓法/饵料即可</text>
      </view>
    </view>

    <!-- 本次出钓装备（默认全选，可勾掉没带的） -->
    <view class="section card-shadow" wx:if="{{equipLoaded}}">
      <view class="title" bindtap="toggleEquipPanel">
        🎒 本次出钓装备
        <text class="title-hint">{{showEquip ? '点击收起' : '点击展开勾选'}}</text>
      </view>
      <block wx:if="{{showEquip}}">
        <view class="equip-actions">
          <text class="equip-act-btn" data-checked="true" bindtap="toggleEquipAll">全选</text>
          <text class="equip-act-btn" data-checked="false" bindtap="toggleEquipAll">全不选</text>
        </view>

        <view class="equip-group" wx:if="{{equip.rods.length}}">
          <view class="equip-group-title">🎣 鱼竿</view>
          <view class="equip-item" wx:for="{{equip.rods}}" wx:key="id" data-cat="rods" data-idx="{{index}}" bindtap="toggleEquipItem">
            <icon type="{{item._checked ? 'success' : 'circle'}}" size="18" color="{{item._checked ? '#1a73e8' : '#ccc'}}"/>
            <text class="equip-text">{{item.name || '鱼竿'}} {{item.length || ''}}{{item.length ? 'm' : ''}} {{item.action || ''}}</text>
          </view>
        </view>

        <view class="equip-group" wx:if="{{equip.mainLines.length}}">
          <view class="equip-group-title">🧵 主线</view>
          <view class="equip-item" wx:for="{{equip.mainLines}}" wx:key="id" data-cat="mainLines" data-idx="{{index}}" bindtap="toggleEquipItem">
            <icon type="{{item._checked ? 'success' : 'circle'}}" size="18" color="{{item._checked ? '#1a73e8' : '#ccc'}}"/>
            <text class="equip-text">{{item.size}}号 {{item.length || ''}}{{item.length ? 'm' : ''}}</text>
          </view>
        </view>

        <view class="equip-group" wx:if="{{equip.subLineHooks.length}}">
          <view class="equip-group-title">🪝 子线双钩</view>
          <view class="equip-item" wx:for="{{equip.subLineHooks}}" wx:key="id" data-cat="subLineHooks" data-idx="{{index}}" bindtap="toggleEquipItem">
            <icon type="{{item._checked ? 'success' : 'circle'}}" size="18" color="{{item._checked ? '#1a73e8' : '#ccc'}}"/>
            <text class="equip-text">{{item.lineSize}}号 {{item.hookType || ''}}{{item.hookSize || ''}} {{item.barb || ''}}</text>
          </view>
        </view>

        <view class="equip-group" wx:if="{{equip.floats.length}}">
          <view class="equip-group-title">🌶️ 浮漂</view>
          <view class="equip-item" wx:for="{{equip.floats}}" wx:key="id" data-cat="floats" data-idx="{{index}}" bindtap="toggleEquipItem">
            <icon type="{{item._checked ? 'success' : 'circle'}}" size="18" color="{{item._checked ? '#1a73e8' : '#ccc'}}"/>
            <text class="equip-text">{{item.name || '浮漂'}} {{item.material || ''}} {{item.shape || ''}}</text>
          </view>
        </view>

        <view class="equip-group" wx:if="{{equip.baits.length}}">
          <view class="equip-group-title">🍚 饵料</view>
          <view class="equip-item" wx:for="{{equip.baits}}" wx:key="id" data-cat="baits" data-idx="{{index}}" bindtap="toggleEquipItem">
            <icon type="{{item._checked ? 'success' : 'circle'}}" size="18" color="{{item._checked ? '#1a73e8' : '#ccc'}}"/>
            <text class="equip-text">{{item.brand || ''}} {{item.name || '饵料'}} {{item.flavor || ''}}</text>
          </view>
        </view>

        <view class="equip-empty" wx:if="{{!equip.rods.length && !equip.mainLines.length && !equip.subLineHooks.length && !equip.floats.length && !equip.baits.length}}">
          钓箱还没有装备，去「装备库」添加后可在此勾选
        </view>
      </block>
    </view>
  </block>

  <!-- 2. 精美摘要卡片区（连接成功 且 非修改状态下 显示） -->
  <view class="summary-card card-shadow" wx:if="{{isConnected && !isModifying}}">
    <view class="status-badge-container">
      <view class="status-badge">
        <view class="pulse-dot"></view>
        <text class="status-text">设备已连接 ⚡</text>
      </view>
    </view>
    
    <view class="summary-title">已锁定出钓配置</view>
    
    <view class="summary-content">
      <view class="summary-item">
        <text class="summary-label">目标鱼种</text>
        <text class="summary-value">{{targetFish}}</text>
      </view>
    </view>
  </view>

  <!-- 3. 底部操作按钮组 -->
  <view class="footer">
    <!-- 未连接状态 -->
    <block wx:if="{{!isConnected}}">
      <button class="btn-primary" bindtap="startSession" loading="{{isConnecting}}">开始作钓 (连接设备)</button>
      <button class="btn-secondary" style="margin-top: 24rpx; width: 100%;" bindtap="goToDecision">无设备 / 出发前：查看出钓决策 🌤️</button>
      <view class="hint">没有 FishProbe 设备也能用：出钓决策基于实时气象+定位，给出开口指数、逐时窗口与 3 日预报</view>
    </block>

    <!-- 已连接，正常查看状态 -->
    <block wx:if="{{isConnected && !isModifying}}">
      <button class="btn-primary btn-space" bindtap="goToDashboard">进入实时监测大屏</button>
      <button class="btn-secondary" bindtap="onTapModify">修改出钓配置</button>
      <view class="hint">配置已锁定，您也可以将手机放回口袋</view>
    </block>

    <!-- 已连接，修改配置状态 -->
    <block wx:if="{{isConnected && isModifying}}">
      <view class="btn-group">
        <button class="btn-cancel" bindtap="onTapCancelModification">取消</button>
        <button class="btn-save" bindtap="onTapSaveModification">保存修改</button>
      </view>
    </block>
  </view>
</view>
