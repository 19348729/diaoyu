.container {
  padding: 40rpx 30rpx;
  background: #f8f9fa;
  min-height: 100vh;
  box-sizing: border-box;
}

.header {
  margin-bottom: 40rpx;
  text-align: center;
}

.header-title {
  font-size: 42rpx;
  font-weight: 800;
  color: #1a1f36;
  letter-spacing: 2rpx;
  background: linear-gradient(120deg, #1a73e8, #0d47a1);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.section {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 35rpx 30rpx;
  margin-bottom: 30rpx;
  transition: all 0.3s ease;
}

.card-shadow {
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.04);
  border: 1px solid rgba(0, 0, 0, 0.01);
}

.title {
  font-size: 30rpx;
  font-weight: 700;
  color: #3c4257;
  margin-bottom: 25rpx;
  letter-spacing: 1rpx;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.tag {
  padding: 12rpx 36rpx;
  border-radius: 30rpx;
  background: #f5f6f8;
  color: #5469d4;
  font-size: 28rpx;
  font-weight: 500;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  border: 1px solid transparent;
}

.tag.active {
  background: #1a73e8;
  color: #ffffff;
  font-weight: bold;
  box-shadow: 0 6rpx 15rpx rgba(26, 115, 232, 0.25);
  transform: translateY(-2rpx);
}

/* 2. 精美摘要卡片样式 */
.summary-card {
  background: linear-gradient(135deg, #ffffff 0%, #fdfdfd 100%);
  border-radius: 32rpx;
  padding: 50rpx 40rpx;
  margin-bottom: 50rpx;
  text-align: center;
  position: relative;
  overflow: hidden;
  border: 1px solid rgba(26, 115, 232, 0.08);
}

.status-badge-container {
  display: flex;
  justify-content: center;
  margin-bottom: 30rpx;
}

.status-badge {
  display: inline-flex;
  align-items: center;
  background: rgba(76, 175, 80, 0.09);
  color: #2e7d32;
  padding: 10rpx 28rpx;
  border-radius: 40rpx;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  border: 1px solid rgba(76, 175, 80, 0.15);
}

.pulse-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #4caf50;
  margin-right: 16rpx;
  box-shadow: 0 0 0 rgba(76, 175, 80, 0.4);
  animation: pulse 1.8s infinite;
}

@keyframes pulse {
  0% {
    box-shadow: 0 0 0 0 rgba(76, 175, 80, 0.7);
  }
  70% {
    box-shadow: 0 0 0 12rpx rgba(76, 175, 80, 0);
  }
  100% {
    box-shadow: 0 0 0 0 rgba(76, 175, 80, 0);
  }
}

.summary-title {
  font-size: 38rpx;
  font-weight: 800;
  color: #1a1f36;
  margin-bottom: 45rpx;
  letter-spacing: 1rpx;
}

.summary-content {
  display: flex;
  justify-content: space-around;
  align-items: center;
  background: #fdfdfd;
  border-radius: 20rpx;
  padding: 30rpx 10rpx;
  border: 1px solid #f1f3f9;
}

.summary-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.summary-label {
  font-size: 24rpx;
  color: #8792a2;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.summary-value {
  font-size: 34rpx;
  color: #1a1f36;
  font-weight: 700;
}

.summary-divider {
  width: 1px;
  height: 60rpx;
  background: #e3e8ee;
}

/* 3. 底部操作按钮组 */
.footer {
  margin-top: 50rpx;
  padding: 0 10rpx;
}

.btn-primary {
  background: linear-gradient(180deg, #1a73e8 0%, #1557b0 100%);
  color: #ffffff;
  border-radius: 40rpx;
  font-size: 34rpx;
  font-weight: 700;
  padding: 22rpx 0;
  box-shadow: 0 8rpx 20rpx rgba(26, 115, 232, 0.25);
  border: none;
  transition: all 0.2s ease;
}

.btn-primary.button-hover {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 10rpx rgba(26, 115, 232, 0.15);
}

.btn-space {
  margin-bottom: 30rpx;
}

.btn-secondary {
  background: #ffffff;
  color: #1a73e8;
  border: 2rpx solid #1a73e8;
  border-radius: 40rpx;
  font-size: 32rpx;
  font-weight: 600;
  padding: 18rpx 0;
  transition: all 0.2s ease;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.02);
}

.btn-secondary.button-hover {
  background: #f1f7fe;
}

.hint {
  text-align: center;
  color: #90a4ae;
  font-size: 26rpx;
  margin-top: 30rpx;
  font-weight: 500;
}

/* 修改状态按钮组 */
.btn-group {
  display: flex;
  gap: 24rpx;
  margin-top: 30rpx;
}

.btn-cancel {
  flex: 1;
  background: #e3e8ee;
  color: #4f5b66;
  border-radius: 40rpx;
  font-size: 32rpx;
  font-weight: 600;
  padding: 20rpx 0;
  border: none;
}

.btn-cancel.button-hover {
  background: #ccd4dc;
}

.btn-save {
  flex: 2;
  background: linear-gradient(180deg, #1a73e8 0%, #1557b0 100%);
  color: #ffffff;
  border-radius: 40rpx;
  font-size: 32rpx;
  font-weight: 700;
  padding: 20rpx 0;
  border: none;
  box-shadow: 0 8rpx 16rpx rgba(26, 115, 232, 0.2);
}

.btn-save.button-hover {
  transform: translateY(1rpx);
}

