.container {
  padding: 30rpx;
  background: #f5f5f5;
  min-height: 100vh;
}
.header {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 40rpx;
  color: #333;
}
.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}
.title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}
.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.tag {
  padding: 10rpx 30rpx;
  border-radius: 30rpx;
  background: #f0f0f0;
  color: #666;
  font-size: 28rpx;
}
.tag.active {
  background: #1a73e8;
  color: #fff;
}
.footer {
  margin-top: 60rpx;
}
.btn-primary {
  background: #1a73e8;
  color: #fff;
  border-radius: 40rpx;
  font-size: 36rpx;
  padding: 20rpx 0;
  box-shadow: 0 4rpx 10rpx rgba(26, 115, 232, 0.3);
}
.hint {
  text-align: center;
  color: #5cb85c;
  font-size: 28rpx;
  margin-top: 20rpx;
}
