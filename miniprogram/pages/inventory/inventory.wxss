.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f5f5f5;
}

.header {
  padding: 40rpx 30rpx;
  background: linear-gradient(135deg, #1a73e8 0%, #1565c0 100%);
  color: #fff;
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.subtitle {
  display: block;
  font-size: 26rpx;
  opacity: 0.8;
}

.tab-bar {
  display: flex;
  background: #fff;
  border-bottom: 1px solid #eee;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 30rpx;
  color: #666;
  position: relative;
}

.tab.active {
  color: #1a73e8;
  font-weight: bold;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background: #1a73e8;
  border-radius: 4rpx;
}

.content-scroll {
  flex: 1;
  padding: 20rpx;
  box-sizing: border-box;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.card {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.card-left {
  width: 80rpx;
  height: 80rpx;
  background: #e3f2fd;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.icon {
  font-size: 40rpx;
}

.card-body {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.item-title {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.item-desc {
  font-size: 26rpx;
  color: #666;
}

.empty-state {
  margin-top: 60rpx;
  padding: 0 40rpx;
}

.add-btn {
  background: #fff;
  color: #1a73e8;
  border: 1px dashed #1a73e8;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: bold;
}
