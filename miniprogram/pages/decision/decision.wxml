<!--
  出钓决策页面
  帮助钓鱼人回答"今天值不值得去钓鱼？"
-->
<view class="container">

  <!-- 鱼种选择器 -->
  <view class="card" style="padding: 16rpx 20rpx;">
    <view style="display: flex; align-items: center; justify-content: space-between;">
      <text style="font-size: 28rpx; color: #333; font-weight: bold;">🐟 目标鱼种</text>
      <picker mode="selector" range="{{fishTypeNames}}" value="{{selectedFishIndex}}" bindchange="onFishTypeChange">
        <view style="font-size: 28rpx; color: #1a73e8; padding: 8rpx 24rpx; background: #e3f2fd; border-radius: 8rpx;">
          {{fishTypeNames[selectedFishIndex]}} ▾
        </view>
      </picker>
    </view>
  </view>

  <!-- 加载中 -->
  <view class="card" wx:if="{{loading}}" style="text-align: center; padding: 60rpx 0;">
    <text style="font-size: 28rpx; color: #999;">正在获取鱼情数据...</text>
  </view>

  <!-- 主体内容 -->
  <block wx:if="{{hasResult && !loading}}">

    <!-- 今日概况大卡片 -->
    <view class="card" style="background: linear-gradient(135deg, {{overallScore >= 75 ? '#e8f5e9, #c8e6c9' : (overallScore >= 55 ? '#fff8e1, #ffecb3' : (overallScore >= 35 ? '#fff3e0, #ffe0b2' : '#fce4ec, #f8bbd0'))}});">
      <view style="display: flex; justify-content: space-between; align-items: center;">
        <view>
          <text style="font-size: 24rpx; color: #666;">今日鱼情评级</text>
          <view style="margin-top: 10rpx;">
            <text style="font-size: 56rpx; font-weight: bold; color: {{overallScore >= 75 ? '#2e7d32' : (overallScore >= 55 ? '#f57f17' : '#d32f2f')}};">{{overallScore}}</text>
            <text style="font-size: 28rpx; color: #666; margin-left: 10rpx;">分</text>
          </view>
          <text style="font-size: 26rpx; color: #555; margin-top: 6rpx; display: block;">{{ratingCn}}</text>
        </view>
        <view style="text-align: right;">
          <text style="font-size: 24rpx; color: #666; display: block;">峰值时段</text>
          <text style="font-size: 36rpx; font-weight: bold; color: #1a73e8;">{{peakHour}}:00</text>
          <text style="font-size: 22rpx; color: #999; display: block;">{{peakScore}} 分</text>
        </view>
      </view>

      <!-- 置信度 -->
      <view style="margin-top: 16rpx; padding-top: 12rpx; border-top: 1px solid rgba(0,0,0,0.08);">
        <text style="font-size: 22rpx; color: #888;">📡 纯天气推测，置信度 {{confidence}}%，仅供参考</text>
      </view>
    </view>

    <!-- 最佳窗口 TOP3 -->
    <view class="card" wx:if="{{bestWindows.length > 0}}">
      <text class="card-title">⏰ 最佳出钓窗口</text>
      <view style="display: flex; flex-direction: column; gap: 12rpx; margin-top: 16rpx;">
        <view wx:for="{{bestWindows}}" wx:key="start_hour" style="display: flex; justify-content: space-between; align-items: center; background: {{index === 0 ? '#e8f5e9' : '#f5f5f5'}}; padding: 16rpx 20rpx; border-radius: 8rpx; {{index === 0 ? 'border: 1px solid #a5d6a7;' : ''}}">
          <view style="display: flex; align-items: center; gap: 12rpx;">
            <text style="font-size: 28rpx; color: {{index === 0 ? '#2e7d32' : '#333'}}; font-weight: {{index === 0 ? 'bold' : 'normal'}};">{{index === 0 ? '🥇' : (index === 1 ? '🥈' : '🥉')}} {{item.label}}</text>
          </view>
          <text style="font-size: 28rpx; font-weight: bold; color: {{item.avg_score >= 75 ? '#2e7d32' : (item.avg_score >= 55 ? '#f57f17' : '#d32f2f')}};">{{item.avg_score}} 分</text>
        </view>
      </view>
    </view>

    <!-- 推荐鱼种 + 战术建议 -->
    <view class="card" wx:if="{{recommendedFish}}">
      <view class="card-title" style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
        <text>🎯 最适宜: {{recommendedFish}}</text>
        <text style="font-size: 40rpx; font-weight: bold; color: #e53935;">{{biteIndex}} 分</text>
      </view>

      <!-- 标签 -->
      <view style="display: flex; flex-wrap: wrap; gap: 10rpx; margin: 16rpx 0;">
        <text wx:for="{{tacticalTags}}" wx:key="*this" style="background: #e3f2fd; color: #1565c0; padding: 6rpx 16rpx; border-radius: 8rpx; font-size: 22rpx;">{{item}}</text>
      </view>

      <!-- 战术建议 -->
      <view wx:if="{{tacticalAdvice}}" style="background: #fff8e1; border: 1px solid #ffecb3; border-radius: 8rpx; padding: 20rpx; margin-top: 12rpx;">
        <!-- 利好信号 -->
        <view wx:if="{{tacticalAdvice.highlight}}" style="background: linear-gradient(135deg, #e8f5e9 0%, #c8e6c9 100%); border: 1px solid #a5d6a7; border-radius: 8rpx; padding: 16rpx; margin-bottom: 16rpx;">
          <text style="font-size: 26rpx; color: #2e7d32; font-weight: bold;">{{tacticalAdvice.highlight}}</text>
        </view>

        <view style="display: flex; flex-direction: column; gap: 10rpx;">
          <view style="display: flex;"><text style="font-size: 24rpx; color: #f57f17; min-width: 110rpx; font-weight: bold;">🌊 水层:</text><text style="font-size: 24rpx; color: #424242; flex: 1;">{{tacticalAdvice.layer}}</text></view>
          <view style="display: flex;"><text style="font-size: 24rpx; color: #f57f17; min-width: 110rpx; font-weight: bold;">🍤 用饵:</text><text style="font-size: 24rpx; color: #424242; flex: 1;">{{tacticalAdvice.bait}}</text></view>
          <view style="display: flex;"><text style="font-size: 24rpx; color: #f57f17; min-width: 110rpx; font-weight: bold;">🎣 方式:</text><text style="font-size: 24rpx; color: #424242; flex: 1;">{{tacticalAdvice.method || '台钓'}}</text></view>
          <view style="display: flex;"><text style="font-size: 24rpx; color: #f57f17; min-width: 110rpx; font-weight: bold;">📏 钓深:</text><text style="font-size: 24rpx; color: #424242; flex: 1;">{{tacticalAdvice.depth || '--'}}</text></view>
          <view style="display: flex;"><text style="font-size: 24rpx; color: #f57f17; min-width: 110rpx; font-weight: bold;">📍 钓位:</text><text style="font-size: 24rpx; color: #424242; flex: 1;">{{tacticalAdvice.spot || '选深浅交界处'}}</text></view>
          <view style="display: flex;"><text style="font-size: 24rpx; color: #f57f17; min-width: 110rpx; font-weight: bold;">🎯 节奏:</text><text style="font-size: 24rpx; color: #424242; flex: 1;">{{tacticalAdvice.rhythm}}</text></view>
          <view wx:if="{{tacticalAdvice.estimated_water_temp}}" style="display: flex;"><text style="font-size: 24rpx; color: #f57f17; min-width: 110rpx; font-weight: bold;">🌡️ 水温:</text><text style="font-size: 24rpx; color: #424242; flex: 1;">{{tacticalAdvice.estimated_water_temp}}</text></view>
          <view wx:if="{{tacticalAdvice.risk && tacticalAdvice.risk !== '当前无明显风险'}}" style="display: flex; margin-top: 8rpx; padding-top: 8rpx; border-top: 1px dashed #ffecb3;">
            <text style="font-size: 24rpx; color: #d32f2f; min-width: 110rpx; font-weight: bold;">⚠️ 风险:</text>
            <text style="font-size: 24rpx; color: #d32f2f; flex: 1;">{{tacticalAdvice.risk}}</text>
          </view>
        </view>
      </view>

      <!-- AI 装备推荐（从数字钓箱匹配） -->
      <view wx:if="{{tacticalAdvice.equipment_advice}}" style="background: #e8f5e9; border: 1px solid #a5d6a7; border-radius: 8rpx; padding: 20rpx; margin-top: 16rpx;">
        <text style="font-size: 26rpx; color: #2e7d32; font-weight: bold; display: block; margin-bottom: 12rpx;">🎒 AI 装备推荐（已匹配你的钓箱）</text>
        <view wx:if="{{tacticalAdvice.equipment_advice.rod && tacticalAdvice.equipment_advice.rod.recommendation}}" style="margin-bottom: 10rpx;">
          <view style="display: flex;">
            <text style="font-size: 24rpx; color: #2e7d32; min-width: 110rpx; font-weight: bold;">🎣 鱼竿:</text>
            <text style="font-size: 24rpx; color: #1b5e20; flex: 1;">{{tacticalAdvice.equipment_advice.rod.recommendation}}{{tacticalAdvice.equipment_advice.rod.matching_id ? ' ✓' : ''}}</text>
          </view>
          <text wx:if="{{tacticalAdvice.equipment_advice.rod.reason}}" style="font-size: 22rpx; color: #666; display: block; margin-left: 110rpx;">{{tacticalAdvice.equipment_advice.rod.reason}}</text>
        </view>
        <view wx:if="{{tacticalAdvice.equipment_advice.main_line && tacticalAdvice.equipment_advice.main_line.recommendation}}" style="margin-bottom: 10rpx;">
          <view style="display: flex;">
            <text style="font-size: 24rpx; color: #2e7d32; min-width: 110rpx; font-weight: bold;">🧵 主线:</text>
            <text style="font-size: 24rpx; color: #1b5e20; flex: 1;">{{tacticalAdvice.equipment_advice.main_line.recommendation}}{{tacticalAdvice.equipment_advice.main_line.matching_id ? ' ✓' : ''}}</text>
          </view>
          <text wx:if="{{tacticalAdvice.equipment_advice.main_line.reason}}" style="font-size: 22rpx; color: #666; display: block; margin-left: 110rpx;">{{tacticalAdvice.equipment_advice.main_line.reason}}</text>
        </view>
        <view wx:if="{{tacticalAdvice.equipment_advice.sub_line_hook && tacticalAdvice.equipment_advice.sub_line_hook.recommendation}}" style="margin-bottom: 10rpx;">
          <view style="display: flex;">
            <text style="font-size: 24rpx; color: #2e7d32; min-width: 110rpx; font-weight: bold;">🪝 子线双钩:</text>
            <text style="font-size: 24rpx; color: #1b5e20; flex: 1;">{{tacticalAdvice.equipment_advice.sub_line_hook.recommendation}}{{tacticalAdvice.equipment_advice.sub_line_hook.matching_id ? ' ✓' : ''}}</text>
          </view>
          <text wx:if="{{tacticalAdvice.equipment_advice.sub_line_hook.reason}}" style="font-size: 22rpx; color: #666; display: block; margin-left: 110rpx;">{{tacticalAdvice.equipment_advice.sub_line_hook.reason}}</text>
        </view>
        <view wx:if="{{tacticalAdvice.equipment_advice.float && tacticalAdvice.equipment_advice.float.recommendation}}" style="margin-bottom: 10rpx;">
          <view style="display: flex;">
            <text style="font-size: 24rpx; color: #2e7d32; min-width: 110rpx; font-weight: bold;">🌶️ 浮漂:</text>
            <text style="font-size: 24rpx; color: #1b5e20; flex: 1;">{{tacticalAdvice.equipment_advice.float.recommendation}}{{tacticalAdvice.equipment_advice.float.matching_id ? ' ✓' : ''}}</text>
          </view>
          <text wx:if="{{tacticalAdvice.equipment_advice.float.reason}}" style="font-size: 22rpx; color: #666; display: block; margin-left: 110rpx;">{{tacticalAdvice.equipment_advice.float.reason}}</text>
        </view>
        <view wx:if="{{tacticalAdvice.equipment_advice.bait && tacticalAdvice.equipment_advice.bait.recommendation}}">
          <view style="display: flex;">
            <text style="font-size: 24rpx; color: #2e7d32; min-width: 110rpx; font-weight: bold;">🍚 饵料:</text>
            <text style="font-size: 24rpx; color: #1b5e20; flex: 1;">{{tacticalAdvice.equipment_advice.bait.recommendation}}{{tacticalAdvice.equipment_advice.bait.matching_id ? ' ✓' : ''}}</text>
          </view>
          <text wx:if="{{tacticalAdvice.equipment_advice.bait.reason}}" style="font-size: 22rpx; color: #666; display: block; margin-left: 110rpx;">{{tacticalAdvice.equipment_advice.bait.reason}}</text>
        </view>
        <text style="font-size: 20rpx; color: #999; display: block; margin-top: 10rpx;">✓ 表示已从你的数字钓箱中匹配</text>
      </view>

      <!-- 鱼种排行 -->
      <view style="margin-top: 16rpx; padding-top: 12rpx; border-top: 1px dashed #eee;" wx:if="{{fishRanking.length > 1}}">
        <text style="font-size: 24rpx; color: #999; display: block; margin-bottom: 10rpx;">🏆 鱼种适宜度排行</text>
        <view style="display: flex; flex-direction: column; gap: 8rpx;">
          <view wx:for="{{fishRanking}}" wx:key="name" style="display: flex; justify-content: space-between; padding: 8rpx 16rpx; background: #f9f9f9; border-radius: 6rpx;">
            <text style="font-size: 26rpx; color: {{index === 0 ? '#e53935' : '#333'}}; font-weight: {{index === 0 ? 'bold' : 'normal'}};">{{index + 1}}. {{item.name}}</text>
            <text style="font-size: 26rpx; font-weight: bold; color: {{item.score >= 75 ? '#2e7d32' : (item.score >= 55 ? '#fb8c00' : '#757575')}};">{{item.score}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 天气信息 -->
    <view class="card" wx:if="{{weatherInfo}}" style="background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);">
      <text class="card-title" style="color: #1565c0;">⛅ 当前天气</text>
      <view style="display: flex; justify-content: space-between; margin-top: 12rpx;">
        <text style="font-size: 30rpx; color: #0d47a1; font-weight: bold;">{{weatherInfo.text}}</text>
        <text style="font-size: 28rpx; color: #1565c0;">{{weatherInfo.air_temp}}℃</text>
      </view>
      <view style="display: flex; justify-content: space-between; margin-top: 8rpx;">
        <text style="font-size: 24rpx; color: #1565c0;">{{weatherInfo.wind_dir}} {{weatherInfo.wind_speed}}m/s</text>
        <text style="font-size: 24rpx; color: #1565c0;">湿度 {{weatherInfo.humidity}}%</text>
      </view>
    </view>

    <!-- 3天日历 -->
    <view class="card" wx:if="{{calendarDays.length > 0}}">
      <text class="card-title">📅 未来3天鱼情</text>
      <view wx:if="{{calendar.comparison}}" style="background: #e3f2fd; border-radius: 6rpx; padding: 12rpx 16rpx; margin: 12rpx 0;">
        <text style="font-size: 24rpx; color: #1565c0;">💡 {{calendar.comparison}}</text>
      </view>
      <view style="display: flex; flex-direction: column; gap: 12rpx;">
        <view wx:for="{{calendarDays}}" wx:key="date" style="display: flex; justify-content: space-between; align-items: center; padding: 16rpx 20rpx; background: {{item.date === calendar.best_day ? '#e8f5e9' : '#f5f5f5'}}; border-radius: 8rpx; {{item.date === calendar.best_day ? 'border: 1px solid #a5d6a7;' : ''}}">
          <view>
            <text style="font-size: 28rpx; color: #333; font-weight: {{item.date === calendar.best_day ? 'bold' : 'normal'}};">{{item.date}}</text>
            <text style="font-size: 24rpx; color: #666; margin-left: 10rpx;">{{item.text_day}} {{item.temp_min}}~{{item.temp_max}}℃</text>
          </view>
          <view style="text-align: right;">
            <text style="font-size: 32rpx; font-weight: bold; color: {{item.score >= 75 ? '#2e7d32' : (item.score >= 55 ? '#f57f17' : '#d32f2f')}};">{{item.score}}</text>
            <text style="font-size: 22rpx; color: #999; display: block;">{{item.rating_cn}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 逐时鱼情概览（简化） -->
    <view class="card" wx:if="{{hourlyScores.length > 0}}">
      <text class="card-title">📊 逐时鱼情</text>
      <view style="display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 12rpx;">
        <view wx:for="{{hourlyScores}}" wx:key="hour" style="width: calc(25% - 6rpx); text-align: center; padding: 10rpx 0; background: {{item.bite_index >= 75 ? '#e8f5e9' : (item.bite_index >= 55 ? '#fff8e1' : (item.bite_index >= 35 ? '#fff3e0' : '#fce4ec'))}}; border-radius: 6rpx;">
          <text style="font-size: 22rpx; color: #666; display: block;">{{item.hour}}:00</text>
          <text style="font-size: 26rpx; font-weight: bold; color: {{item.bite_index >= 75 ? '#2e7d32' : (item.bite_index >= 55 ? '#f57f17' : '#d32f2f')}};">{{item.bite_index}}</text>
          <text style="font-size: 20rpx; color: #999; display: block;">{{item.weather_text}}</text>
        </view>
      </view>
    </view>

  </block>

</view>
